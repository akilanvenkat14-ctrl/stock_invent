@model List<StockTransaction>
@{
    ViewData["Title"] = "Stock Transactions";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-arrow-left-right"></i> Stock Transactions</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Transaction</a>
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Date</th>
                    <th>Product</th>
                    <th>Type</th>
                    <th class="text-end">Quantity</th>
                    <th>Notes</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.TransactionDate.ToLocalTime().ToString("g")</td>
                        <td>@t.Product?.Name <small class="text-muted">(@t.Product?.SKU)</small></td>
                        <td>
                            @if (t.Type == TransactionType.StockIn)
                            {
                                <span class="badge bg-success">Stock In</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Stock Out</span>
                            }
                        </td>
                        <td class="text-end">@t.Quantity</td>
                        <td>@t.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="p-4 text-center text-muted">No transactions yet. Record your first stock movement!</div>
    }
</div>
