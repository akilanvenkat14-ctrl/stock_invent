@model List<Product>
@{
    ViewData["Title"] = "Products";
    var search = ViewBag.Search as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-box"></i> Products</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Product</a>
</div>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Search by name, SKU or category..." />
        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Index" class="btn btn-outline-danger">Clear</a>
        }
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>SKU</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th class="text-end">Price</th>
                    <th class="text-end">Qty</th>
                    <th class="text-end">Reorder</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr class="@(p.QuantityInStock <= p.ReorderLevel ? "low-stock" : "")">
                        <td><code>@p.SKU</code></td>
                        <td>@p.Name</td>
                        <td>@p.Category?.Name</td>
                        <td class="text-end">@p.UnitPrice.ToString("C")</td>
                        <td class="text-end">
                            @if (p.QuantityInStock <= p.ReorderLevel)
                            {
                                <span class="badge bg-danger">@p.QuantityInStock</span>
                            }
                            else
                            {
                                @p.QuantityInStock
                            }
                        </td>
                        <td class="text-end">@p.ReorderLevel</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.Any())
    {
        <div class="p-4 text-center text-muted">No products found.</div>
    }
</div>
