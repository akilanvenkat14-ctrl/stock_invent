# 1. Use the official .NET SDK image to build the app
FROM ://microsoft.com AS build
WORKDIR /src

# Copy csproj and restore dependencies
COPY *.csproj ./
RUN dotnet restore

# Copy everything else and build the release
COPY . ./
RUN dotnet publish -c Release -o /app/out

# 2. Build the runtime image
FROM ://microsoft.com AS runtime
WORKDIR /app
COPY --from=build /app/out .

# Render dynamically assigns a port, ASP.NET needs to listen on 0.0.0.0
ENV ASPNETCORE_URLS=http://+:10000
EXPOSE 10000

ENTRYPOINT ["dotnet", "asp.net_stosck_inventry1.dll"]
